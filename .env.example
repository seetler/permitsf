# Existing integrations
OPENAI_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (use the provider's TLS configuration)
DATABASE_URL=

# Clerk user IDs, comma-separated. First ID receives new cases automatically.
# Set your own ID first; add teammates here as you grow. Never put this in NEXT_PUBLIC_*.
CIVIC_EASY_STAFF_IDS=
CIVIC_EASY_NOTIFY_EMAIL=info@evolvedigitallyllc.com

# Email: a verified sender on your Resend account
RESEND_API_KEY=
EMAIL_FROM=
# Secure random secret used by Vercel Cron or another scheduler
CRON_SECRET=

# Token for a PRIVATE Vercel Blob store (never a public store)
BLOB_READ_WRITE_TOKEN=

# Optional prices in USD cents; each defaults to 9900 ($99) per permit.
CIVIC_PRICE_BUSINESS_LAUNCH=9900
CIVIC_PRICE_OUTDOOR_USE=9900
CIVIC_PRICE_HOME_PROJECT=9900
CIVIC_PRICE_GENERAL_PERMIT=9900
